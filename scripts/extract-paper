#!/usr/bin/env bash
# Extract a paper's text; needs python3 with pypdf (see AGENTS.md "Lint and gates").
set -euo pipefail
pdf="${1:?usage: extract-paper <pdf> — writes a NUL-free .txt sidecar beside it}"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m scripts.extract_paper "$pdf"
